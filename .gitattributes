# Normalise to LF in the repository. CI runs on Linux as well as Windows, and
# a checkout that carries CRLF into a shell script breaks there in ways that
# are tedious to diagnose.
* text=auto eol=lf

# Windows-only launchers must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.ico binary
*.png binary
*.jpg binary
*.pdf binary
*.exe binary
*.icns binary
